{
	"name": "@lolmath/charts",
	"version": "0.0.0",
	"private": false,
	"description": "Hextech-styled TanStack Charts components for lolmath.net",
	"type": "module",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"publint": "publint",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [],
	"author": "lolmath.net",
	"sideEffects": false,
	"license": "ISC",
	"dependencies": {
		"@tanstack/charts": "catalog:",
		"cva": "catalog:",
		"d3-shape": "catalog:"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"homepage": "https://ui.lolmath.net",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lolmath/lolmath.git",
		"directory": "packages/charts"
	},
	"bugs": {
		"url": "https://github.com/lolmath/lolmath/issues"
	},
	"devDependencies": {
		"@tsdown/css": "catalog:",
		"@types/d3-shape": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"publint": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"react": ">=19",
		"react-dom": ">=19"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			}
		},
		"./css": {
			"types": "./dist/css.d.ts",
			"default": "./dist/index.css"
		},
		"./css.d.ts": "./dist/css.d.ts"
	}
}
