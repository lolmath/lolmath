{
  "name": "@lolmath/calc",
  "version": "0.0.6",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest --coverage",
    "coverage": "vitest run --coverage",
    "docs": "vite-node ./docs.ts",
    "lint": "publint"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "devDependencies": {
    "@structured-types/api": "^3.46.12",
    "@types/node": "^20.6.2",
    "@vitest/coverage-c8": "^0.33.0",
    "@vitest/coverage-v8": "^0.34.4",
    "tsup": "^7.2.0",
    "turbo": "^1.10.14",
    "typescript": "^5.2.2",
    "vite-node": "^0.34.4",
    "vitest": "^0.34.4"
  },
  "dependencies": {
    "publint": "^0.2.2"
  }
}
