{
	"name": "@lolmath/calc",
	"version": "0.1.1",
	"private": false,
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup && tsc -p tsconfig.build.json",
		"dev": "tsup --watch",
		"test": "vitest --coverage",
		"coverage": "vitest run --coverage",
		"docs": "pnpm exec typedoc",
		"publint": "publint",
		"typecheck": "tsgo --noEmit"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://gitlab.com/lol-math/lolmath.git",
		"directory": "packages/calc"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"devDependencies": {
		"@lolmath/typedoc": "workspace:*",
		"@types/node": "^26.0.0",
		"@typescript/native-preview": "7.0.0-dev.20260619.1",
		"@vitest/coverage-v8": "^4.1.9",
		"publint": "^0.3.21",
		"tsup": "^8.5.1",
		"turbo": "^2.9.18",
		"typedoc": "^0.28.19",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	}
}
