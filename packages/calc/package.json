{
	"name": "@lolmath/calc",
	"version": "0.1.1",
	"private": false,
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup && tsc -p tsconfig.build.json",
		"dev": "tsup --watch",
		"test": "vitest --coverage",
		"coverage": "vitest run --coverage",
		"docs": "pnpm exec typedoc",
		"publint": "publint",
		"typecheck": "tsc --noEmit"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lolmath/lolmath.git",
		"directory": "packages/calc"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"devDependencies": {
		"@lolmath/typedoc": "workspace:*",
		"@vitest/coverage-v8": "catalog:",
		"publint": "catalog:",
		"tsup": "catalog:",
		"turbo": "catalog:",
		"typedoc": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"@types/node": "catalog:"
	},
	"dependencies": {}
}
