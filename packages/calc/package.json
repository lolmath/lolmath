{
	"name": "@lolmath/calc",
	"version": "0.0.7",
	"private": false,
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"files": ["dist"],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest --coverage",
		"coverage": "vitest run --coverage",
		"docs": "vite-node ./docs.ts",
		"lint": "publint"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"devDependencies": {
		"@structured-types/api": "^3.46.12",
		"@types/node": "^22.5.4",
		"@vitest/coverage-v8": "^2.1.1",
		"tsup": "^8.2.4",
		"turbo": "^2.1.2",
		"typescript": "^5.6.2",
		"vite-node": "^2.1.1",
		"vitest": "^2.1.1"
	},
	"dependencies": {
		"publint": "^0.2.10"
	}
}
