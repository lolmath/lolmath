{
	"name": "@lolmath/ui",
	"version": "9.3.0",
	"private": false,
	"description": "lolmath.net UI",
	"type": "module",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"publint": "publint",
		"typecheck": "tsc --noEmit",
		"docs": "node ./docs.ts"
	},
	"keywords": [],
	"author": "lolmath.net",
	"sideEffects": false,
	"license": "ISC",
	"dependencies": {
		"cva": "catalog:",
		"react-aria": "catalog:",
		"react-aria-components": "catalog:",
		"sonner": "catalog:"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"homepage": "https://ui.lolmath.net",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lolmath/lolmath.git",
		"directory": "packages/ui"
	},
	"bugs": {
		"url": "https://github.com/lolmath/lolmath/issues"
	},
	"devDependencies": {
		"@tsdown/css": "catalog:",
		"@types/node": "catalog:",
		"@types/postcss-url": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"lightningcss": "catalog:",
		"postcss-url": "catalog:",
		"publint": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"tailwindcss": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"react": ">=19",
		"react-dom": ">=19",
		"tailwindcss": ">=3"
	},
	"peerDependenciesMeta": {
		"tailwindcss": {
			"optional": true
		}
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			}
		},
		"./css": {
			"types": "./dist/css.d.ts",
			"default": "./dist/index.css"
		},
		"./tailwind": {
			"types": "./dist/css.d.ts",
			"default": "./dist/tailwind.css"
		},
		"./font/beaufort": {
			"types": "./dist/css.d.ts",
			"default": "./dist/font/beaufort/beaufort.css"
		},
		"./font/spiegel": {
			"types": "./dist/css.d.ts",
			"default": "./dist/font/spiegel/spiegel.css"
		},
		"./css.d.ts": "./dist/css.d.ts"
	}
}
