		"dist"
	],
	"scripts": {
		"build": "modern build",
		"dev": "modern build --watch",
		"publint": "publint",
		"typecheck": "tsgo --noEmit",
		"docs": "node ./docs.ts"
	},
	"keywords": [],
	"author": "lolmath.net",
	"license": "ISC",
	"dependencies": {
		"cva": "1.0.0-beta.4",
		"react-aria": "^3.45.0",
		"react-aria-components": "^1.14.0",
		"sonner": "^2.0.7"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"homepage": "https://ui.lolmath.net",
	"repository": {
		"type": "git",
		"url": "git+https://gitlab.com/lol-math/lolmath.git",
		"directory": "packages/ui"
	},
	"bugs": {
		"url": "https://gitlab.com/lol-math/lolmath/-/issues",
		"email": "incoming+lol-math-lolmath-41959739-1qbix14106nxnde3k5iusimi8-issue@incoming.gitlab.com"
	},
	"devDependencies": {
		"@modern-js/module-tools": "^2.69.4",
		"@types/node": "^25.0.3",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@typescript/native-preview": "7.0.0-dev.20251217.1",
		"publint": "^0.3.16",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"vitest": "^4.0.16"
	},
	"peerDependencies": {
		"react": ">=19",
		"react-dom": ">=19",
		"tailwindcss": ">=3"
	},
	"peerDependenciesMeta": {
		"tailwindcss": {
			"optional": true
		}
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/es/index.d.ts",
				"default": "./dist/es/index.js"
			},
			"require": {
				"types": "./dist/lib/index.d.cts",
				"default": "./dist/lib/index.cjs"
			}
		},
		"./css": {
			"import": "./dist/es/index.css",
			"require": "./dist/lib/index.css"
		},
		"./tailwind": "./dist/tailwind.css",
		"./font/beaufort": {
			"import": "./dist/font/beaufort/beaufort.css",
			"require": "./dist/font/beaufort/beaufort.css"
		},
		"./font/spiegel": {
			"import": "./dist/font/spiegel/spiegel.css",
			"require": "./dist/font/spiegel/spiegel.css"
		}
	}
}
