{
	"name": "@lolmath/ddragon",
	"private": false,
	"repository": {
		"url": "git+https://gitlab.com/lol-math/lolmath.git",
		"type": "git",
		"directory": "packages/ddragon"
	},
	"homepage": "https://gitlab.com/lol-math/lolmath/-/tree/main/packages/ddragon",
	"version": "2.0.4",
	"description": "Get data from League of Legends Ddragon API.",
	"license": "MIT",
	"author": "Mees van Dongen",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "tsgo",
		"lint": "publint",
		"test": "vitest",
		"docs": "pnpm exec typedoc"
	},
	"targets": {
		"main": {
			"optimize": true
		},
		"module": {
			"optimize": true
		}
	},
	"devDependencies": {
		"@typescript/native-preview": "7.0.0-dev.20250829.3",
		"publint": "^0.3.12",
		"typedoc": "^0.28.11",
		"typescript": "^5.9.2",
		"vitest": "^3.2.4",
		"@lolmath/typedoc": "workspace:*"
	},
	"files": [
		"/dist",
		"/src",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./global": {
			"types": "./dist/global.d.ts",
			"import": "./dist/global.js"
		}
	},
	"type": "module"
}
