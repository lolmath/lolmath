{
	"name": "@lolmath/ddragon",
	"private": false,
	"repository": {
		"url": "git+https://github.com/lolmath/lolmath.git",
		"type": "git",
		"directory": "packages/ddragon"
	},
	"homepage": "https://github.com/lolmath/lolmath/tree/main/packages/ddragon",
	"version": "2.0.4",
	"description": "Get data from League of Legends Ddragon API.",
	"license": "MIT",
	"author": "Mees van Dongen",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "tsc",
		"publint": "publint",
		"test": "vitest",
		"docs": "pnpm exec typedoc"
	},
	"targets": {
		"main": {
			"optimize": true
		},
		"module": {
			"optimize": true
		}
	},
	"devDependencies": {
		"@lolmath/typedoc": "workspace:*",
		"typescript": "catalog:",
		"publint": "catalog:",
		"typedoc": "catalog:",
		"vitest": "catalog:"
	},
	"files": [
		"/dist",
		"/src",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./global": {
			"types": "./dist/global.d.ts",
			"import": "./dist/global.js"
		}
	},
	"type": "module"
}
