{
	"name": "@lolmath/ddragon",
	"private": false,
	"repository": {
		"url": "https://gitlab.com/lol-math/lolmath/-/tree/main/packages/ddragon",
		"type": "git"
	},
	"homepage": "https://gitlab.com/lol-math/lolmath/-/tree/main/packages/ddragon",
	"version": "2.0.2",
	"description": "Get data from League of Legends Ddragon API.",
	"license": "MIT",
	"author": "Mees van Dongen",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "tsgo",
		"lint": "publint",
		"test": "vitest",
		"typedoc": "typedoc --disableSources --githubPages false --plugin typedoc-plugin-markdown --entryFileName docs.md --readme none --hideBreadcrumbs --excludePrivate --out ./docs ./src"
	},
	"targets": {
		"main": {
			"optimize": true
		},
		"module": {
			"optimize": true
		}
	},
	"devDependencies": {
		"@typescript/native-preview": "7.0.0-dev.20250829.3",
		"publint": "^0.3.12",
		"typedoc": "^0.28.11",
		"typedoc-plugin-markdown": "^4.8.1",
		"vitest": "^3.2.4"
	},
	"files": [
		"/dist",
		"/src",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./global": {
			"types": "./dist/global.d.ts",
			"import": "./dist/global.js"
		}
	},
	"type": "module"
}
