{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"docs": {
			"dependsOn": ["^docs"],
			"inputs": ["src/**/*.tsx", "src/**/*.ts"],
			"outputs": ["docs/**", "pages/**"]
		},
		"build": {
			"dependsOn": ["docs", "^build"],
			"inputs": [
				"src/**/*.tsx",
				"src/**/*.ts",
				"test/**/*.ts",
				"test/**/*.tsx",
				"./*.*"
			],
			"outputs": ["dist/**", "build/**", "storybook-static/**", "out/**"]
		},
		"lint": {
			"outputs": []
		},
		"test": {
			"outputs": [],
			"inputs": ["src/**/*.tsx", "src/**/*.ts", "test/**/*.ts", "test/**/*.tsx"]
		},
		"deploy": {
			"inputs": ["dist/**", "build/**", "storybook-static/**", "out/**"],
			"dependsOn": ["build", "test", "lint"],
			"outputs": []
		},
		"dev": {
			"outputs": [],
			"inputs": ["src/**/*.tsx", "src/**/*.ts"]
		},
		"typecheck": {
			"outputs": [],
			"inputs": ["src/**/*.tsx", "src/**/*.ts", "./*.*"]
		}
	}
}
