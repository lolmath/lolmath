{
	"name": "@lolmath/monorepo",
	"version": "0.0.0",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"docs": "turbo run docs",
		"build": "turbo run build",
		"build:ui-storybook": "turbo run build --filter @lolmath/ui-storybook",
		"build:docs": "turbo run build --filter @lolmath/docs",
		"publint": "turbo run publint",
		"test": "turbo run test",
		"cicd": "turbo run build publint test",
		"deploy": "turbo run deploy --env-mode=loose",
		"typecheck": "turbo run typecheck",
		"dev": "turbo run dev",
		"dev:ui-storybook": "turbo run dev --filter @lolmath/ui-storybook",
		"publish-packages": "turbo run build publint test && changeset version && changeset publish",
		"changeset": "changeset",
		"fix": "npx @biomejs/biome check --write"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@changesets/cli": "^2.31.0",
		"turbo": "^2.9.18"
	},
	"packageManager": "pnpm@11.8.0"
}
