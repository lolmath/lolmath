{
	"name": "@lolmath/monorepo",
	"version": "0.0.0",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"docs": "turbo run docs",
		"build": "turbo run build",
		"publint": "turbo run publint",
		"test": "turbo run test",
		"cicd": "turbo run build publint test",
		"deploy": "turbo run deploy --env-mode=loose",
		"typecheck": "turbo run typecheck",
		"dev": "turbo run dev",
		"dev:ui:storybook": "turbo run dev --filter @lolmath/ui-storybook",
		"publish-packages": "turbo run build publint test && changeset version && changeset publish",
		"changeset": "changeset",
		"fix": "npx @biomejs/biome check --write"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.10",
		"@changesets/cli": "^2.29.8",
		"changesets-gitlab": "^0.13.4",
		"turbo": "^2.6.3"
	},
	"packageManager": "pnpm@10.26.0"
}
