{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"module": "ESNext",
		"skipLibCheck": true,

		/* Bundler mode */
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "react-jsx",

		/* Linting */
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"paths": {
			"@lolmath/charts": ["../../packages/charts/src/index"],
			"@lolmath/charts/css": ["../../packages/charts/src/style.css"],
			"@lolmath/ui": ["../../packages/ui/src/index"],
			"@lolmath/ui/font": ["../../packages/ui/public/*"],
			"@lolmath/ui/css": ["../../packages/ui/src/style.css"]
		}
	},
	"references": [{ "path": "./tsconfig.node.json" }]
}
